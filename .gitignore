# ==============================================================================
# Latch Public Repository .gitignore
# STRICT WHITELIST: Only documentation and public distribution files allowed.
# ==============================================================================

# 1. Ignore everything in the repository root by default
/*
.*

# 2. Allow Git configuration
!.gitignore

# 3. Whitelist public legal, release metadata, and documentation files
!README.md
!LICENSE
!appcast.xml
!docs/
!docs/**

# 4. Safety net: never allow sensitive files even if placed in allowed directories
**/.DS_Store
**/*.swp
**/*~
**/*.key
**/*.p12
**/*.pem
**/*.p8
**/*.mobileprovision
**/*.provisionprofile
**/*.plist
**/*.enc
**/*.bak
**/*backup*
**/*.dmg
**/*.pkg
**/*.app
**/*.zip
